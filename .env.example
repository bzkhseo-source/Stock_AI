# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env는 절대 공유하거나 커밋하지 마세요.

# ── 데이터베이스 ──
# 비워두면 data/app.db (SQLite) 사용. 운영: Neon 연결 문자열 (예: postgresql://user:pw@ep-xxx.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# ── 웹 ──
# 세션 암호화 키. 아무 긴 무작위 문자열 (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
# 초대 코드 (쉼표로 여러 개). 비워두면 로그인 없이 열림 → 로컬 개발에서만 비워두세요.
INVITE_CODES=

# ── 외부 API ──
# OpenDART 인증키 (opendart.fss.or.kr)
DART_API_KEY=
# KRX 정보데이터시스템 계정 (data.krx.co.kr) — pykrx 시가총액·지수·수급 조회에 필요
KRX_ID=
KRX_PW=
# Google AI Studio Gemini API 키
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 하루 LLM 호출 상한 (무료 티어 보호)
LLM_DAILY_LIMIT=200

# ── 분석 기준값 (베타에서 조정) ──
MOVE_THRESHOLD_PCT=10
VOLUME_SPIKE_RATIO=3
LOW_LIQUIDITY_KRW=500000000
SURGE_5D_PCT=30
NEWS_QUERIES_PER_RUN=30
